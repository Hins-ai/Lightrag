  <data key="d12">1779777465</data>
  <data key="d13"></data>
</edge>
<edge source="Order Cancellation" target="Paid Order Cancellation">
  <data key="d7">1.0</data>
  <data key="d8">Paid order cancellation is a subtype of order cancellation where the passenger still has to pay after the order is closed.</data>
  <data key="d9">specialization,subtype</data>
  <data key="d10">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
