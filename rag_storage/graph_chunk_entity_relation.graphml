  <data key="d12">1779777465</data>
  <data key="d13"></data>
</edge>
<edge source="Offline Order" target="宏鹄管理后台">
  <data key="d7">1.0</data>
  <data key="d8">宏鹄管理后台also handles offline orders, though cancellation is not available for them; only refunds can be processed.</data>
  <data key="d9">management,platform</data>
  <data key="d10">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d11">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d12">1779777465</data>
  <data key="d13"></data>
</edge>
<edge source="Order Cancellation" target="Merchant Administrator">
  <data key="d7">1.0</data>
  <data key="d8">Merchant administrator performs order cancellation, including free and paid types, on online orders.</data>
  <data key="d9">execution,operation</data>
  <data key="d10">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
