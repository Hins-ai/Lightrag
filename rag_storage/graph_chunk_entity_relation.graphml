<graph edgedefault="undirected"><node id="Online Bus Customer Service Management and Merchant Training Manual V20250811">
  <data key="d0">Online Bus Customer Service Management and Merchant Training Manual V20250811</data>
  <data key="d1">content</data>
  <data key="d2">A manual providing instructions on using the Honghu backend for customer service management and merchant training.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-000</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777461</data>
  <data key="d6"></data>
</node>
<node id="Honghu Backend">
  <data key="d0">Honghu Backend</data>
  <data key="d1">artifact</data>
  <data key="d2">A software management platform used by bus groups for handling customer service issues including generating virtual numbers, processing refunds, and order closures.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-000</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777461</data>
  <data key="d6"></data>
</node>
<node id="Bus Group">
  <data key="d0">Bus Group</data>
  <data key="d1">organization</data>
  <data key="d2">The public transportation company responsible for customer service issues, who uses the Honghu Backend.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-000</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777461</data>
  <data key="d6"></data>
</node>
<node id="Didi">
  <data key="d0">Didi</data>
  <data key="d1">organization</data>
  <data key="d2">The technology company that provides the Honghu Backend platform and supports the bus group's customer service operations.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-000</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777461</data>
  <data key="d6"></data>
</node>
<node id="Virtual Number">
  <data key="d0">Virtual Number</data>
  <data key="d1">method</data>
  <data key="d2">A feature that generates a temporary virtual phone number to allow customer service to contact passengers without revealing real numbers.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-000</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777461</data>
  <data key="d6"></data>
</node>
<node id="Refund">
  <data key="d0">Refund</data>
  <data key="d1">method</data>
  <data key="d2">A feature allowing refunds for online and offline orders, supporting full or partial refunds.&lt;SEP&gt;Refund is the operation to return payment to a passenger for an order, applicable to both online and offline orders, with details displayed after processing.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-000&lt;SEP&gt;doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777461</data>
  <data key="d6"></data>
</node>
<node id="Order Closure">
  <data key="d0">Order Closure</data>
  <data key="d1">method</data>
  <data key="d2">A feature to close orders, either free or paid, for resolving issues.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-000</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777461</data>
  <data key="d6"></data>
</node>
<node id="Passenger">
  <data key="d0">Passenger</data>
  <data key="d1">person</data>
  <data key="d2">The user of the online bus service who may contact customer service with issues.&lt;SEP&gt;Passenger is the customer who books rides and may experience problems like duplicate charges, being charged without taking a ride, lost items, or driver service issues.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-000&lt;SEP&gt;doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777461</data>
  <data key="d6"></data>
</node>
<node id="Customer Service">
  <data key="d0">Customer Service</data>
  <data key="d1">person</data>
  <data key="d2">The staff of the bus group responsible for handling passenger complaints and using the Honghu Backend features.&lt;SEP&gt;Customer Service is the team that handles passenger inquiries and complaints, using standard scripts to comfort passengers, record issues, and provide guidance on invoice application and navigation problems.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-000&lt;SEP&gt;doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-002</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Online Order">
  <data key="d0">Online Order</data>
  <data key="d1">concept</data>
  <data key="d2">Orders placed through the Didi mini-program or app, with payment after trip completion.&lt;SEP&gt;Online order refers to a ride order placed and paid through the online platform, supported for cancellation and refund operations by merchant administrators.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-000&lt;SEP&gt;doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Offline Order">
  <data key="d0">Offline Order</data>
  <data key="d1">concept</data>
  <data key="d2">Orders where the passenger scans a code to board and pays directly.&lt;SEP&gt;Offline order refers to a ride order conducted offline, possibly involving cash payment, and can be refunded in case of duplicate charges.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-000&lt;SEP&gt;doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Administrator">
  <data key="d0">Administrator</data>
  <data key="d1">person</data>
  <data key="d2">Staff members designated by the bus company to have permissions for generating virtual numbers and managing passenger contact, especially for future restricted access.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-000</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="宏鹄管理后台">
  <data key="d0">宏鹄管理后台</data>
  <data key="d1">artifact</data>
  <data key="d2">宏鹄管理后台is a management backend system used by merchant administrators to handle online and offline ride orders, including operations like refund and order cancellation.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Order Cancellation">
  <data key="d0">Order Cancellation</data>
  <data key="d1">method</data>
  <data key="d2">Order cancellation is the operation to close an order, available for unpaid online orders, and can be free or paid depending on the scenario.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Free Order Cancellation">
  <data key="d0">Free Order Cancellation</data>
  <data key="d1">method</data>
  <data key="d2">Free order cancellation closes an online order without requiring the passenger to pay, used when the order is unpaid and issues like duplicate charge or non-ride are confirmed.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Paid Order Cancellation">
  <data key="d0">Paid Order Cancellation</data>
  <data key="d1">method</data>
  <data key="d2">Paid order cancellation closes an order but still requires the passenger to pay, applied when the passenger has alighted but the driver has not ended the trip.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Merchant Administrator">
  <data key="d0">Merchant Administrator</data>
  <data key="d1">person</data>
  <data key="d2">Merchant administrator is a role that operates refund and order cancellation in the宏鹄管理后台, handling issues like duplicate charges and incorrect ride charges.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Driver">
  <data key="d0">Driver</data>
  <data key="d1">person</data>
  <data key="d2">Driver is the service provider who may be involved in issues such as not ending a trip, misoperation leading to charges without ride, or service complaints.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Duplicate Charge">
  <data key="d0">Duplicate Charge</data>
  <data key="d1">concept</data>
  <data key="d2">Duplicate charge is a situation where a passenger is charged twice for the same ride, detectable by matching online and offline orders by date, time, and driver.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Charge Without Ride">
  <data key="d0">Charge Without Ride</data>
  <data key="d1">concept</data>
  <data key="d2">Charge without ride occurs when a passenger is charged despite not having taken the ride, possibly due to driver error or failure to cancel correctly, resolved by refund or free cancellation.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Driver Service Issue">
  <data key="d0">Driver Service Issue</data>
  <data key="d1">concept</data>
  <data key="d2">Driver service issue refers to complaints about driver behavior, requiring investigation and possible penalties, with standard scripts used to appease the passenger.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Early Drop-off Fare Issue">
  <data key="d0">Early Drop-off Fare Issue</data>
  <data key="d1">concept</data>
  <data key="d2">Early drop-off fare issue arises when a passenger wants to alight before the destination but the fare remains unchanged due to the fixed-price model of网约公交.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Lost Item">
  <data key="d0">Lost Item</data>
  <data key="d1">concept</data>
  <data key="d2">Lost item is a situation where a passenger leaves belongings in a vehicle, triggering a search procedure and standard responses to reassure the passenger.&lt;SEP&gt;Lost Item is a passenger complaint type involving missing personal belongings, handled by recording details and arranging search.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001&lt;SEP&gt;doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-002</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Standard Script">
  <data key="d0">Standard Script</data>
  <data key="d1">content</data>
  <data key="d2">Standard script is a predefined response template used by customer service to address common issues like service complaints and lost items.&lt;SEP&gt;Standard Script is a set of predefined comforting responses used by customer service to address passenger complaints regarding lost items, distant stops, and other issues.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001&lt;SEP&gt;doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-002</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="网约公交">
  <data key="d0">网约公交</data>
  <data key="d1">concept</data>
  <data key="d2">网约公交is a ride-hailing bus service with a fixed fare model, where early drop-off does not reduce the fare, and it is mentioned in the context of fare adjustment policies.&lt;SEP&gt;网约公交is an online-hailed bus service that recommends pickup stops based on passenger and driver locations, ensuring walking distance generally under 300 meters.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001&lt;SEP&gt;doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-002</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="公交公司">
  <data key="d0">公交公司</data>
  <data key="d1">organization</data>
  <data key="d2">公交公司is the bus operating company that makes final decisions on fare adjustments in cases of early drop-off, as mentioned in the standard script for handling early alightment issues.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="滴滴出行">
  <data key="d0">滴滴出行</data>
  <data key="d1">organization</data>
  <data key="d2">滴滴出行is a ride-hailing platform that provides the online-hailed bus service via its app or mini-program.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-002</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="公交集团">
  <data key="d0">公交集团</data>
  <data key="d1">organization</data>
  <data key="d2">公交集团is the bus operating company responsible for managing the online-hailed bus service and handling certain customer issues.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-002</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="电子税务局">
  <data key="d0">电子税务局</data>
  <data key="d1">organization</data>
  <data key="d2">电子税务局is the electronic tax bureau system used for issuing invoices and requiring periodic facial recognition authentication.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-002</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="网约公交乘客端培训手册">
  <data key="d0">网约公交乘客端培训手册</data>
  <data key="d1">content</data>
  <data key="d2">网约公交乘客端培训手册is a training manual containing a knowledge base of common passenger questions for the online-hailed bus passenger end.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-002</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Stop Too Far">
  <data key="d0">Stop Too Far</data>
  <data key="d1">event</data>
  <data key="d2">Stop Too Far is a passenger complaint about recommended pickup stops being too far, with a guarantee that walking distance is generally under 300 meters.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-002</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Invoice Issue">
  <data key="d0">Invoice Issue</data>
  <data key="d1">event</data>
  <data key="d2">Invoice Issue is a passenger inquiry or problem regarding invoice generation or abnormal invoicing errors.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-002</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Navigation Unreasonable">
  <data key="d0">Navigation Unreasonable</data>
  <data key="d1">event</data>
  <data key="d2">Navigation Unreasonable is a passenger complaint about unreasonable navigation, which may be resolved by partial refund if strongly disputed.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-002</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Product Issues">
  <data key="d0">Product Issues</data>
  <data key="d1">event</data>
  <data key="d2">Product Issues are general passenger inquiries about product-related matters, addressed using the knowledge base in the training manual.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-002</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Facial Recognition Authentication">
  <data key="d0">Facial Recognition Authentication</data>
  <data key="d1">method</data>
  <data key="d2">Facial Recognition Authentication is a security procedure required for login to the electronic tax bureau to resolve invoicing exceptions.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-002</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
  <data key="d5">1779777462</data>
  <data key="d6"></data>
</node>
<node id="Partial Refund">
  <data key="d0">Partial Refund</data>
  <data key="d1">method</data>
  <data key="d2">Partial Refund is a compensation method that the bus company can apply at its discretion for navigation complaints.</data>
  <data key="d3">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-002</data>
  <data key="d4">网约公交客服管理·商户培训手册V20250905.pdf</data>
