</edge>
<edge source="Online Order" target="Order Cancellation">
  <data key="d7">1.0</data>
  <data key="d8">Order cancellation is only applicable to online orders, with a visible entry when the order is unpaid.</data>
  <data key="d9">applicable to,closure</data>
  <data key="d10">doc-2b3a06f7135e2b57c94c1307b69cc5a4-chunk-001</data>
